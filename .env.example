# PostgreSQL connection (docker-compose default shown)
DATABASE_URL=postgres://puds:puds@localhost:5432/puds_dev

# Secret used to sign auth sessions/cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Public origin of the app (used for auth callbacks and CSRF checks)
ORIGIN=http://localhost:5173

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Directory for uploaded documents (defaults to ./uploads)
UPLOAD_DIR=uploads
